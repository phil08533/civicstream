# Used only by the scheduled ingestion job (GitHub Actions secret). Never exposed to the browser.
# Free key: https://api.congress.gov/sign-up/
CONGRESS_API_KEY=

# Public site URL, used for canonical links and sitemap.
NEXT_PUBLIC_SITE_URL=https://phil08533.github.io/civicstream
# Set to /civicstream for a GitHub Pages project site; leave empty for a custom domain.
NEXT_PUBLIC_BASE_PATH=/civicstream

